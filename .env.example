# Copy this file to .env and fill in your Hugging Face credentials. .env is gitignored.

# Hugging Face access token — https://huggingface.co/settings/tokens
HF_TOKEN=

# Multimodal Gemma model ID on Hugging Face (supports image + text)
# Available models: google/gemma-3-27b-it, google/gemma-3-12b-it, google/gemma-3-4b-it
HF_MODEL_ID=google/gemma-3-27b-it

# Optional dedicated or custom inference endpoint URL
# Default (when unset): uses Hugging Face Router (https://router.huggingface.co/v1/chat/completions)
# Example dedicated endpoint: https://xxxx.endpoints.huggingface.cloud/v1/chat/completions
# HF_ENDPOINT_URL=

# Optional configurable image upload limit in MB (default: 10)
MAX_UPLOAD_MB=10

# Optional app metadata
APP_TITLE=Scribble2Structure
