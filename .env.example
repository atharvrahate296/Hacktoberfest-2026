# Copy this file to .env and fill in your Gemini API key. .env is gitignored.

# Gemini API key - https://aistudio.google.com/apikey
# Inference runs against Google's servers; no weights are downloaded and no GPU
# is used. The key stays server-side and is never sent to the browser.
GEMINI_API_KEY=

# Gemma model id, served by the Gemini API.
# Must match app/ai_client.py DEFAULT_MODEL when left blank.
#
#  gemma-3-27b-it        27B, strongest extraction (default)
#  gemma-3-12b-it        12B, faster, weaker on dense handwriting
#  gemma-3-4b-it         4B,  fastest, weakest
#  gemma-4-26b-a4b-it    Gemma 4 mixture-of-experts
#
# The 1B size is text-only and does not accept images, so it is not listed.
GEMMA_MODEL=

# Optional. Comma-separated model ids tried in order when the primary is
# saturated, rate-limited, or not served. Empty means failures are reported
# rather than silently answered by a smaller model.
GEMMA_MODEL_FALLBACKS=

# Optional. Gemma is served with the default sampler, so these are left unset by
# default: sending a non-default value is rejected by the endpoint.
# GEMMA_TEMPERATURE=1.0
# GEMMA_TOP_P=0.95

# Optional generation limits
# GEMMA_MAX_OUTPUT_TOKENS=4096
# GEMINI_TIMEOUT_MS=120000

# Optional endpoint overrides (advanced; defaults are the public Gemini API)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta

# Optional image upload limit in MB (default: 10)
MAX_UPLOAD_MB=10

# Optional app metadata
APP_TITLE=Scribble2Structure