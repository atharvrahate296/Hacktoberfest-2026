# Copy this file to .env and fill in your Gemini API key. .env is gitignored.
#
# You do not have to use this file: the Settings screen in the app takes the
# key too, tests it against the API and saves it locally in
# .scribble2structure/credentials.json (gitignored, owner-readable only).
# A key saved there takes precedence over the one below.

# Gemini API key - https://aistudio.google.com/apikey
# Inference runs against Google's servers; no weights are downloaded and no GPU
# is used. The key stays server-side and is never sent to the browser.
GEMINI_API_KEY=

# Model id, served by the Gemini API.
# The variable is named GEMMA_MODEL for continuity, but any vision-capable id
# below may be set there. Must match app/ai_client.py DEFAULT_MODEL when blank.
#
#  gemini-2.5-flash-lite   Gemini, default. Cheapest and fastest; the API's
#                          recommended model for high-volume data extraction.
#                          Thinking is off by default on this size.
#  gemini-2.5-flash        Gemini. Slower, stronger reasoning on dense images.
#  gemma-3-27b-it          Gemma. Strong open-weight extraction.
#  gemma-3-12b-it          Gemma, lighter.
#  gemma-3-4b-it           Gemma, lightest vision size.
#  gemma-4-26b-a4b-it      Gemma 4 mixture-of-experts, if enabled on your key.
#
# The Gemma 3 1B size is text-only and rejects every image, so it is not listed.
GEMMA_MODEL=gemini-2.5-flash-lite

# Optional. Comma-separated model ids tried in order when the primary is
# saturated, rate-limited, or not served. Empty means failures are reported
# rather than silently answered by a different model.
GEMMA_MODEL_FALLBACKS=

# Optional. Sampler knobs are omitted by default so one config works for both
# families: Gemma is served with the default sampler and rejects others.
# Uncomment only if the configured model accepts them.
# GEMMA_TEMPERATURE=1.0
# GEMMA_TOP_P=0.95

# Optional generation limits
# GEMMA_MAX_OUTPUT_TOKENS=4096
# GEMINI_TIMEOUT_MS=120000

# Optional endpoint overrides (advanced; defaults are the public Gemini API)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta

# Optional image upload limit in MB (default: 10)
MAX_UPLOAD_MB=10

# Optional app metadata
APP_TITLE=Scribble2Structure