# Copy this file to .env and fill in your Hugging Face credentials. .env is gitignored.

# Hugging Face access token - https://huggingface.co/settings/tokens
# Only needed the first time the model weights are downloaded.
HF_TOKEN=

# Vision-language model loaded locally with HuggingFace Transformers.
# Weights are cached in ~/.cache/huggingface after the first run.
# This must match app/ai_client.py DEFAULT_MODEL when left blank.
#
#  ~1 GB  HuggingFaceTB/SmolVLM-500M-Instruct  (default, fits 4 GB VRAM)
#  ~4 GB  Qwen/Qwen2-VL-2B-Instruct            (best quality/VRAM balance)
#  ~6 GB  Qwen/Qwen2.5-VL-3B-Instruct          (better, needs 8 GB VRAM)
#  ~9 GB  google/gemma-3-4b-it                 (gated, best accuracy)
HF_MODEL_ID=HuggingFaceTB/SmolVLM-500M-Instruct

# Optional image upload limit in MB (default: 10)
MAX_UPLOAD_MB=10

# Optional app metadata
APP_TITLE=Scribble2Structure