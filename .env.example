# Copy this file to .env and fill in your key. .env is gitignored.

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id. Must accept IMAGE input.
# Free tier (default): google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Optional
# APP_URL=https://github.com/rohan-kokatare/scribble2structure
# APP_TITLE=Scribble2Structure
